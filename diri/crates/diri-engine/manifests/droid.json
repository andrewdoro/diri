{
  "_notice": "Screen-detection predicates adapted from the herdr project (https://github.com/herdrdev/herdr, src/detect/manifests/*.toml), licensed Apache-2.0. Translated from herdr's TOML rule schema into Dirijor's JSON predicate schema and re-prioritised for this engine; the agent capability block is Dirijor's own.",
  "_screensNotice": "Rules match screens captured from Droid 0.233.0 driven through the Engine (tests/droid_real.rs, fixtures in tests/fixtures/droid_screens).",
  "schemaVersion": 2,
  "id": "droid",
  "version": "2026.10.04.1",
  "statusModel": "full",
  "agent": {
    "id": "droid",
    "displayName": "Droid",
    "shortLabel": "droid",
    "glyph": "◈",
    "aliases": [
      "droid",
      "factory",
      "factory-droid"
    ],
    "firstClass": true,
    "setup": {
      "url": "https://docs.factory.ai/cli/getting-started/quickstart",
      "installHint": "Install Droid with Factory's installer or a supported package manager.",
      "signInHint": "Run droid, then use /login if prompted."
    },
    "statusAuthority": "screen",
    "binary": "droid",
    "resume": {
      "style": "flag",
      "token": "--resume"
    },
    "conversation": {
      "resume": {
        "latestArgs": [
          "--resume",
          "--last"
        ]
      },
      "stripArgs": [
        {
          "token": "--resume",
          "value": "nonoption"
        },
        {
          "token": "-r",
          "value": "nonoption"
        },
        {
          "token": "--last"
        },
        {
          "token": "--fork",
          "value": "any"
        }
      ]
    },
    "_resumeNotice": "Verified against Droid 0.233.0 (`droid --help` and a PTY run): a bare `--resume` opens the session picker; `--resume --last` reopens the most recent session in the current folder. Droid has no flag for a caller-minted session id, so resume is the folder's latest conversation, like Kimi's and Copilot's `--continue`. Declared under `conversation` so an exited Droid stays resumable without a provider id.",
    "returnToLoginShell": true,
    "foregroundExecNames": [
      "droid"
    ],
    "approve": {
      "text": "",
      "submit": true
    },
    "deny": {
      "text": "\u001b",
      "submit": false
    },
    "envScrubPrefixes": [
      "DIRI_",
      "DIRIJOR_"
    ]
  },
  "rules": [
    {
      "id": "workspace-trust-dialog",
      "state": "blockedQuestion",
      "priority": 390,
      "region": "bottom_non_empty_lines",
      "regionLines": 20,
      "when": {
        "all": [
          {
            "contains": "Trust this folder?"
          },
          {
            "contains": "Enter to confirm · Esc to exit"
          }
        ]
      },
      "flags": [
        "visible_blocker"
      ]
    },
    {
      "id": "blocked-approval-panel",
      "state": "blockedPermission",
      "priority": 300,
      "region": "bottom_non_empty_lines",
      "regionLines": 14,
      "when": {
        "all": [
          {
            "any": [
              {
                "contains": "enter select"
              },
              {
                "contains": "enter to select"
              }
            ]
          },
          {
            "any": [
              {
                "contains": "esc cancel"
              },
              {
                "contains": "esc to cancel"
              }
            ]
          },
          {
            "any": [
              {
                "lineRegex": "(?i)^\\s*│?\\s*[❯>]?\\s*yes, allow"
              },
              {
                "lineRegex": "(?i)^\\s*│?\\s*[❯>]?\\s*no, cancel"
              }
            ]
          }
        ]
      },
      "flags": [
        "visible_blocker"
      ],
      "capture": {
        "region": "bottom_non_empty_lines",
        "regionLines": 12,
        "maxChars": 400
      }
    },
    {
      "id": "blocked-ask-user",
      "state": "blockedQuestion",
      "priority": 290,
      "region": "bottom_non_empty_lines",
      "regionLines": 3,
      "when": {
        "all": [
          {
            "contains": "Navigate"
          },
          {
            "contains": "Select • ESC stop agent"
          }
        ]
      },
      "flags": [
        "visible_blocker"
      ],
      "capture": {
        "region": "bottom_non_empty_lines",
        "regionLines": 12,
        "maxChars": 400
      }
    },
    {
      "id": "working-spinner-stop",
      "state": "working",
      "priority": 110,
      "region": "bottom_non_empty_lines",
      "regionLines": 8,
      "when": {
        "lineRegex": "^\\s*[\\u2800-\\u28FF]\\s.*\\(Press ESC to stop\\)"
      }
    },
    {
      "id": "working-esc-stop",
      "state": "working",
      "priority": 100,
      "region": "bottom_non_empty_lines",
      "regionLines": 8,
      "when": {
        "contains": "(press esc to stop)"
      }
    },
    {
      "id": "idle-composer",
      "state": "idle",
      "priority": 50,
      "region": "bottom_non_empty_lines",
      "regionLines": 4,
      "when": {
        "all": [
          {
            "lineRegex": "^\\s*│ >.*│\\s*$"
          },
          {
            "lineRegex": "\\? for help"
          }
        ]
      }
    }
  ]
}
